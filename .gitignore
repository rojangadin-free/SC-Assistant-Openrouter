# Custom
#.github/workflows/cicd.yaml
# Admin conflict decisions are environment-specific runtime state
conflict_resolutions.json
conflict_resolutions.json.tmp
# Unanswered-question log (runtime chat traffic, per deployment)
content_gaps.json
content_gaps.json.tmp
# Answer votes and the ask-a-human queue (runtime state, per deployment)
answer_feedback.json
answer_feedback.json.tmp
escalations.json
escalations.json.tmp
# In-flight upload/indexing progress. Pure scratch state: it describes threads
# in one running container, so a committed copy would only ever describe a job
# that finished on someone else's machine.
index_jobs.json
index_jobs.json.tmp

# Admin-entered academic-calendar periods (real dates differ per deployment,

# and a committed one would be silently wrong for the next school year)
calendar_periods.json
calendar_periods.json.tmp
# Posted announcements. Committing these is worse than committing the other
# stores: a "classes are suspended tomorrow" pinned in the repo would come back
# to life on every fresh deployment, on a day when it is simply false.
announcements.json
announcements.json.tmp

# Per-document effective dates (which handbook supersedes which). Runtime state
# for the same reason as the stores above: it holds admin corrections for the
# documents THIS deployment actually has, and a committed copy would claim dates
# for files that are not in the next deployment's corpus. It is also cheap to
# rebuild — `python tools/backfill_doc_dates.py --apply` re-derives every
# inferred date from the documents themselves.
doc_freshness.json
doc_freshness.json.tmp





